# Copie este ficheiro para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).
# Sem estas variáveis, a plataforma arranca em MODO DEMONSTRAÇÃO
# (os dados ficam guardados apenas no navegador).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=a-sua-chave-anon-publica
